# Gate tools: the containers tools/gate.sh runs, each pinned by tag AND manifest-list (image index) digest.
# The digest is the pin; the tag is a label for humans. Same format as env/pins.env: KEY=value, no quotes, no spaces.
# How the digests were read (2026-10-09): `docker buildx imagetools inspect <image>:<tag>`, line "Digest:" of the top-level index
# (not a per-platform manifest). Tags were chosen as the newest stable release tag listed by the Docker Hub tags API on that date.
# Changing any line is an env change (class: pin) and needs a THIRD-PARTY.md row update (the release gate checks it).
# Not run with `docker run` anywhere except tools/gate.sh, which labels every container conduit-env.gate=1.

# koalaman/shellcheck v0.11.0 (released 2025-08-04)
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
# rhysd/actionlint 1.7.12 (2026-03-30)
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
# pipelinecomponents/yamllint 0.35.13 (2026-05-23); a wrapper image around yamllint (cytopia/yamllint was last updated 2023-08-04)
YAMLLINT_IMAGE=pipelinecomponents/yamllint:0.35.13@sha256:5ab5eb7da0ed5e606b07c1723fc8b275e925189f70ac259b26b7329cb5f8f44d
# hadolint/hadolint v2.15.1 (2026-07-31); the plain tag has no shell, which is fine: only its entrypoint is used
HADOLINT_IMAGE=hadolint/hadolint:v2.15.1@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d
# lycheeverse/lychee 0.24.2 (2026-05-01)
LYCHEE_IMAGE=lycheeverse/lychee:0.24.2@sha256:e2d19e57cf6ab037026f20b8e449a1f30d9d7f81eef4194763aab2eab20bd28d
