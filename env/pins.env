# Every upstream pin of the environment, in one place.
# Read by compose.yaml (through `include: env_file`), by tools/ (`. env/pins.env`), and by the drift workflow.
# Format: KEY=value. No quotes, no spaces, no `export`, so compose, POSIX sh and a five-line parser all agree.
# Changing any line here is an env change: it needs a new env-vN tag and a CHANGELOG entry (class: pin).

# Backend: c4ffein/realworld-django-ninja, default branch master, commit dated 2026-05-05T21:38:43Z
BACKEND_REPO=https://github.com/c4ffein/realworld-django-ninja.git
BACKEND_SHA=04ef47ced437ee8795a13bdcbc2eff2be19e33bd

# Frontend: realworld-apps/vue-realworld-example-app, default branch master, commit dated 2026-06-10T22:02:26Z
FRONTEND_REPO=https://github.com/realworld-apps/vue-realworld-example-app.git
FRONTEND_SHA=f7e48c8178602ce25d43293bc6f8ca51d84ae222

# Base images. The digest is the pin; the tag is only a label for humans and for the drift report.
# Python 3.12 comes from the backend's own Dockerfile (FROM python:3.12-slim-bookworm); PostgreSQL 18 from its own docker-compose.yml.
PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
POSTGRES_IMAGE=postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
# The vue repo declares no Node or bun version and ships bun.lock; Phase 1 used the then-current oven/bun and recorded its digest.
BUN_IMAGE=oven/bun:latest@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
NGINX_IMAGE=nginx:1-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
